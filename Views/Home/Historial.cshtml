
@model List<TramitesWeb.Models.Solicitud>

@{
    ViewData["Title"] = "Historial de solicitudes";
}

<div class="mb-4">
    <p class="text-uppercase small fw-semibold text-secondary mb-2">
        Seguimiento
    </p>
    <h1 class="h2">Historial de solicitudes</h1>
    <p class="text-secondary">
        Consulta los folios registrados y genera una demostración del reporte.
    </p>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-4">
        <div class="summary-card h-100">
            <p class="text-secondary mb-1">Solicitudes registradas</p>
            <p class="display-6 fw-semibold mb-0">@Model.Count</p>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-3 p-md-4">
        <div class="d-flex flex-column flex-md-row
                    justify-content-between align-items-md-center gap-3 mb-3">
            <h2 class="h5 mb-0">Solicitudes registradas</h2>

            <button type="button" id="downloadReport"
                    class="btn btn-primary"
                    disabled="@(Model.Count == 0)">
                Descargar reporte
            </button>
        </div>

        <div id="reportStatus" class="alert d-none"
             role="status" aria-live="polite" tabindex="-1"></div>

        <div id="reportLoader" class="text-center py-4 d-none"
             role="status" aria-live="polite">
            <div class="spinner-border text-primary mb-2"
                 aria-hidden="true"></div>
            <p class="mb-0">Generando reporte de demostración...</p>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <caption class="visually-hidden">
                    Solicitudes almacenadas en la base de datos.
                </caption>
                <thead>
                    <tr>
                        <th scope="col">Folio</th>
                        <th scope="col">Solicitante</th>
                        <th scope="col">Fecha de registro</th>
                        <th scope="col">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4">
                                Todavía no hay solicitudes registradas.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var solicitud in Model)
                        {
                            <tr>
                                <th scope="row">@solicitud.Folio</th>
                                <td>@solicitud.Nombre</td>
                                <td>
                                    @(solicitud.FechaRegistro.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))
                                </td>
                                <td>
                                    <span class="status-badge">
                                        @solicitud.EstadoSolicitud
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <p class="small text-secondary mb-0">
            Los registros mostrados proceden de la base de datos.
            La descarga del reporte sigue siendo simulada.
        </p>
    </div>
</div>

@section Scripts {
    <script src="~/js/historial.js" asp-append-version="true"></script>
}
