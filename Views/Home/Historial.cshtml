
@{
    ViewData["Title"] = "Historial de solicitudes";
}

<div class="mb-4">
    <p class="text-uppercase small fw-semibold text-secondary mb-2">
        Seguimiento
    </p>
    <h1 class="h2">Historial de solicitudes</h1>
    <p class="text-secondary">
        Consulta los folios registrados y genera una demostración del reporte.
    </p>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-4">
        <div class="summary-card h-100">
            <p class="text-secondary mb-1">Solicitudes de demostración</p>
            <p class="display-6 fw-semibold mb-0" id="totalSolicitudes">3</p>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4">
        <div class="summary-card h-100">
            <p class="text-secondary mb-1">Último folio de demostración</p>
            <p class="h4 fw-semibold mb-0">TR-00043</p>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-3 p-md-4">
        <div class="d-flex flex-column flex-md-row
                    justify-content-between align-items-md-center gap-3 mb-3">
            <h2 class="h5 mb-0">Solicitudes registradas</h2>

            <button type="button" id="downloadReport"
                    class="btn btn-primary">
                Descargar reporte
            </button>
        </div>

        <div id="reportStatus" class="alert d-none"
             role="status" aria-live="polite" tabindex="-1"></div>

        <div id="reportLoader" class="text-center py-4 d-none"
             role="status" aria-live="polite">
            <div class="spinner-border text-primary mb-2"
                 aria-hidden="true"></div>
            <p class="mb-0">Generando reporte de demostración...</p>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <caption class="visually-hidden">
                    Historial ficticio de solicitudes para probar la interfaz.
                </caption>
                <thead>
                    <tr>
                        <th scope="col">Folio</th>
                        <th scope="col">Solicitante</th>
                        <th scope="col">Fecha</th>
                        <th scope="col">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <th scope="row">TR-00041</th>
                        <td>María González</td>
                        <td>20/10/2026</td>
                        <td><span class="status-badge">Registrada</span></td>
                    </tr>
                    <tr>
                        <th scope="row">TR-00042</th>
                        <td>José Hernández</td>
                        <td>22/10/2026</td>
                        <td><span class="status-badge">Registrada</span></td>
                    </tr>
                    <tr>
                        <th scope="row">TR-00043</th>
                        <td>Laura Martínez</td>
                        <td>24/10/2026</td>
                        <td><span class="status-badge">Registrada</span></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <p class="small text-secondary mb-0">
            Datos ficticios utilizados únicamente para el diseño de la interfaz.
        </p>
    </div>
</div>

@section Scripts {
    <script src="~/js/historial.js" asp-append-version="true"></script>
}
